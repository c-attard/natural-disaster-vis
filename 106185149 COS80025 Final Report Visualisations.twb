      <column caption='Coordinates' datatype='spatial' name='[Calculation_1784832894713782272]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT([Latitude],[Longitude])' />
      </column>
      <column caption='Yearly GDP Growth' datatype='real' name='[Calculation_1784832894732480515]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COVAR([Calculation_2321324200766205959],[Total GDP])/VAR([Calculation_2321324200766205959])*365.25' />
      </column>
      <column caption='n_days' datatype='integer' name='[Calculation_1784832894735843333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,#1/1/2013#,[Date])' />
      </column>
      <column caption='Total Deaths Yearly Increase' datatype='real' name='[Calculation_1784832894736470022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COVAR([Calculation_1784832894735843333],[Total Deaths])/VAR([Calculation_1784832894735843333])*365.25' />
      </column>
      <column caption='GDP n_days' datatype='integer' name='[Calculation_2321324200766205959]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,#1/1/2013#,[date])' />
